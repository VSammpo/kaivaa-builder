        "encoding": "utf-8-sig",
        "python": "# 1. Filtrer les lignes où 'Dénomination de l'unité légale' n'est pas None\ndf = df[df['Dénomination de l\\'unité légale'].notna()]\n\n# 2. Garder les colonnes nécessaires et dédupliquer sur SIREN\ndf = df[['SIREN', 'Dénomination de l\\'unité légale', 'Activité principale de l\\'établissement.1', 'Géolocalisation de l\\'établissement']].drop_duplicates(subset='SIREN', keep='first')\n\n# 3. Split la colonne Géolocalisation en Latitude et Longitude\ndf[['Latitude', 'Longitude']] = df['Géolocalisation de l\\'établissement'].str.split(',', expand=True)\n\n# 4. Convertir Latitude et Longitude en numérique\ndf['Latitude'] = pd.to_numeric(df['Latitude'], errors='coerce')\ndf['Longitude'] = pd.to_numeric(df['Longitude'], errors='coerce')\n\n# 5. Renommer les colonnes et supprimer la colonne Géolocalisation\ndf = df.rename(columns={\n    'Dénomination de l\\'unité légale': 'Nom_Entreprise',\n    'Activité principale de l\\'établissement.1': 'NACE_REV_2'\n})\n\ndf = df[['SIREN', 'NACE_REV_2', 'Nom_Entreprise', 'Latitude', 'Longitude']]"
      },
