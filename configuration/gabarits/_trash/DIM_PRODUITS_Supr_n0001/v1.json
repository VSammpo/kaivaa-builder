      "sep": ",",
      "encoding": "utf-8-sig",
      "python": "# ===== DIM PRODUIT (sans import, sans variable globale) =====\r\n\r\nt = df.copy()\r\n\r\n# --- helpers locaux ---\r\ndef _clean_num(x):\r\n    if x is None:\r\n        return None\r\n    s = str(x).strip().replace(\"\\u00A0\", \" \").replace(\" \", \"\")\r\n    s = s.replace(\",\", \".\")\r\n    if s == \"\" or s == \"-\":\r\n        return None\r\n    try:\r\n        return float(s)\r\n    except Exception:\r\n        return None\r\n\r\n# Nettoyage nombres pour litrage et unités\r\nt[\"_liters\"] = t[\"Liters sold\"].apply(_clean_num)\r\nt[\"_units\"]  = t[\"Volume sold\"].apply(_clean_num)\r\n\r\n# Contenance estimée par produit (ml) = 1000 * sum(litres) / sum(unités)\r\nsum_df = (\r\n    t.groupby(\"Finance code\")[[\"_liters\",\"_units\"]]\r\n      .sum(min_count=1)\r\n      .reset_index()\r\n)\r\ndef _safe_cont_ml(row):\r\n    u = row[\"_units\"]\r\n    L = row[\"_liters\"]\r\n    if u is None or u == 0 or L is None:\r\n        return None\r\n    return 1000.0 * L / u\r\nsum_df[\"contenance_ml\"] = sum_df.apply(_safe_cont_ml, axis=1)\r\n\r\n# Dictionnaire de mapping Finance code -> contenance_ml\r\ncont_map = dict(zip(sum_df[\"Finance code\"].astype(str), sum_df[\"contenance_ml\"]))\r\n\r\n# --- Identifiants (test : tout = Finance code) ---\r\nt[\"produit_id\"] = t[\"Finance code\"].astype(str).str.strip()\r\nt[\"id_produit_sell_out\"] = t[\"produit_id\"]\r\nt[\"id_produit_sell_in\"]  = t[\"produit_id\"]\r\nt[\"ean_gtin_13\"] = \"\"\r\nt[\"id_canonique_produit\"] = t[\"produit_id\"]\r\n\r\n# --- Hiérarchie & libellés (sources présentes) ---\r\nt[\"brand_owner\"] = \"\"\r\nt[\"is_mdd\"] = False\r\nt[\"groupe\"] = \"\"\r\nt[\"fabricant\"] = \"\"\r\nt[\"marque\"]       = t[\"Brand\"].astype(str)\r\nt[\"sous_marque\"]  = t[\"SubBrand\"].astype(str)\r\nt[\"axe\"]          = t[\"Axe\"].astype(str)\r\nt[\"categorie\"]    = t[\"Metier\"].astype(str)\r\nt[\"segment\"]      = t[\"Class\"].astype(str)\r\nt[\"sous_segment\"] = t[\"SubMetier\"].astype(str)\r\nt[\"type_produit\"] = \"\"\r\nt[\"gamme\"]        = \"\"\r\nt[\"ligne\"]        = t[\"Signature\"].astype(str)\r\nt[\"positionnement_prix\"] = \"\"\r\n\r\n# --- Format / EQ depuis la contenance calculée ---\r\nt[\"contenance_unitaire_valeur\"] = t[\"Finance code\"].astype(str).map(cont_map)\r\nt[\"contenance_unitaire_unite\"]  = t[\"contenance_unitaire_valeur\"].apply(lambda x: \"ml\" if isinstance(x,(int,float)) else \"\")\r\nt[\"unite_format\"] = \"\"\r\nt[\"format_pack\"]  = \"\"\r\nt[\"nb_unites_par_pack\"] = None\r\nt[\"unite_eq\"] = \"L\"\r\nt[\"qty_uc_vers_eq\"] = t[\"contenance_unitaire_valeur\"].apply(lambda x: (float(x)/1000.0) if isinstance(x,(int,float)) else None)\r\n\r\n# --- Divers non fournis dans le test ---\r\nt[\"variant\"] = \"\"\r\nt[\"taux_alcool_pct\"] = None\r\nt[\"origine_pays\"] = \"\"\r\nt[\"date_lancement\"] = None\r\nt[\"statut_catalogue\"] = \"\"\r\n\r\ncols = [\r\n    \"produit_id\",\"id_produit_sell_out\",\"id_produit_sell_in\",\"ean_gtin_13\",\"id_canonique_produit\",\r\n    \"brand_owner\",\"is_mdd\",\"groupe\",\"fabricant\",\"marque\",\"sous_marque\",\"axe\",\"categorie\",\"segment\",\r\n    \"sous_segment\",\"type_produit\",\"gamme\",\"ligne\",\"positionnement_prix\",\"unite_format\",\"format_pack\",\r\n    \"contenance_unitaire_valeur\",\"contenance_unitaire_unite\",\"nb_unites_par_pack\",\"unite_eq\",\"qty_uc_vers_eq\",\r\n    \"variant\",\"taux_alcool_pct\",\"origine_pays\",\"date_lancement\",\"statut_catalogue\"\r\n]\r\n\r\n# Déduplication par produit_id\r\nseen = set()\r\nrows = []\r\nfor _, r in t.iterrows():\r\n    pid = r[\"produit_id\"]\r\n    if pid not in seen:\r\n        seen.add(pid)\r\n        rows.append([r.get(c, None) for c in cols])\r\n\r\ndf = type(t)(rows, columns=cols)\r\n"
    },
