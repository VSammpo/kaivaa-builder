      "sep": ",",
      "encoding": "utf-8-sig",
      "python": "# ===== FACT SELL-OUT (sans import) =====\r\n\r\nt = df.copy()\r\n\r\n# --- Periode_ID = ordre d'apparition des semaines (End week) ---\r\npid_map = {}\r\npid_counter = 1\r\nper_ids = []\r\nfor v in t[\"End week\"]:\r\n    key = str(v)\r\n    if key not in pid_map:\r\n        pid_map[key] = pid_counter\r\n        pid_counter += 1\r\n    per_ids.append(pid_map[key])\r\nt[\"Periode_ID\"] = per_ids\r\n\r\n# --- Distributeur / Enseigne / Canal à partir de Channel ---\r\ndistrib = []\r\nenseigne = []\r\ncanal = []\r\nfor v in t[\"Channel\"]:\r\n    toks = str(v).strip().split()\r\n    if len(toks) == 0:\r\n        distrib.append(\"\")\r\n        enseigne.append(\"\")\r\n        canal.append(\"\")\r\n    else:\r\n        d = toks[0].capitalize()\r\n        distrib.append(d)\r\n        enseigne.append(d)\r\n        c = toks[-1].upper() if len(toks) > 1 else \"\"\r\n        canal.append(c)\r\nt[\"Distributeur\"] = distrib\r\nt[\"Enseigne\"] = enseigne\r\nt[\"Canal\"] = canal\r\n\r\n# --- Contexte constant ---\r\nt[\"Marché\"] = \"France\"\r\nt[\"Région\"] = \"France\"\r\nt[\"Devise\"] = \"EUR\"\r\n\r\n# --- Produit & nom ---\r\nt[\"ID_produit\"]  = t[\"Finance code\"].astype(str).str.strip()\r\nt[\"Nom_produit\"] = t[\"Product name\"].astype(str)\r\n\r\n# --- Nettoyage nombres FR (sans pandas top-level) ---\r\ndef _to_num_series(series):\r\n    out = []\r\n    for x in series:\r\n        if x is None:\r\n            out.append(None)\r\n            continue\r\n        s = str(x).replace(\"\\u00A0\", \" \").replace(\" \", \"\")\r\n        s = s.replace(\",\", \".\")\r\n        try:\r\n            out.append(float(s))\r\n        except Exception:\r\n            out.append(None)\r\n    return out\r\n\r\nt[\"Ventes_valeur\"]     = None  # pas d'€\r\nt[\"Ventes_unites\"]     = _to_num_series(t[\"Volume sold\"])\r\nt[\"Ventes_volume_eq\"]  = _to_num_series(t[\"Liters sold\"])\r\nt[\"Prix_moyen_unite\"]  = None  # non calculable sans €\r\n\r\n# --- Promo / Distribution : vides ---\r\nfor c in [\r\n    \"Ventes_promo_valeur\",\"Ventes_hors_promo_valeur\",\r\n    \"Ventes_promo_unite\",\"Ventes_hors_promo_unite\",\r\n    \"Ventes_promo_volume_eq\",\"Ventes_hors_promo_volume_eq\",\r\n    \"Distribution_numérique\",\"Distribution_valeur\"\r\n]:\r\n    t[c] = None\r\nt[\"Nb_points_vente\"] = [None] * len(t)\r\n\r\n# --- Dates : on garde les chaînes source (tu n'as pas besoin de parsing ici) ---\r\nt[\"Date_début\"] = t[\"Start week week\"]\r\nt[\"Date_fin\"]   = t[\"End week\"]\r\n\r\ncols = [\r\n    \"Date_début\",\"Date_fin\",\"Periode_ID\",\"Distributeur\",\"Enseigne\",\"Canal\",\r\n    \"Marché\",\"Région\",\"ID_produit\",\"Nom_produit\",\"Devise\",\"Ventes_valeur\",\r\n    \"Ventes_unites\",\"Ventes_volume_eq\",\"Prix_moyen_unite\",\r\n    \"Ventes_promo_valeur\",\"Ventes_hors_promo_valeur\",\r\n    \"Ventes_promo_unite\",\"Ventes_hors_promo_unite\",\r\n    \"Ventes_promo_volume_eq\",\"Ventes_hors_promo_volume_eq\",\r\n    \"Distribution_numérique\",\"Distribution_valeur\",\"Nb_points_vente\"\r\n]\r\n\r\ndf = t.loc[:, cols]\r\n"
    },
