      "python": "df = df.rename(columns={\"CODE CLIENT\": \"CODE_CLIENT\"})\ndf = df.rename(columns={\"CODE_ARTICLE\": \"CODE_PRODUIT\"})\ncol = \"Chiffre_daffaires\"\ndf[\"CA_num\"] = (df[col].astype(str)\n                   .str.replace(r'[^\\d,\\-\\s]', '', regex=True)\n                   .str.replace(r'[\\u00A0\\u202F ]', '', regex=True)\n                   .str.replace(',', '.', regex=False)\n                ).pipe(pd.to_numeric, errors='coerce')\ndf['CODE_PERIODE'] =df['CODE_PERIODE'].astype(str)\ndf = df[df[\"CA_num\"] > 0].copy()\n"
