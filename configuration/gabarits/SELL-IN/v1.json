      "name": "Prix moyen",
      "description": "Prix moyen de la ligne",
      "output_column": "Prix moyen",
      "param_schema": [],
      "required_columns": [
        "Chiffre_daffaires",
        "Volumes"
      ],
      "code": "import numpy as np\r\nimport pandas as pd\r\n\r\nvalue = (\r\n    pd.to_numeric(df[\"Chiffre_daffaires\"], errors=\"coerce\")\r\n    .div(pd.to_numeric(df[\"Volumes\"], errors=\"coerce\"))\r\n    .replace([np.inf, -np.inf], 0)\r\n    .fillna(0)\r\n)\r\n",
      "order": 3
    }
  ],
