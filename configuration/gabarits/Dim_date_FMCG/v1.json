  "methods": [
    {
      "id": "cfc3452e-582c-41cd-afbe-781767172c12",
      "name": "Numéro_semaine_table",
      "description": "Numéro de la semaine (sans prendre en compte l'année)",
      "output_column": "Numéro_semaine_table",
      "param_schema": [],
      "required_columns": [
        "Année",
        "Semaine"
      ],
      "code": "_ord = df['Année'].astype(int)*52 + (df['Semaine'].astype(int)-1)\r\nvalue = (_ord - _ord.min() + 1).astype(int)\r\n",
      "order": 1
    },
    {
      "id": "74cb616b-68a1-41d8-b238-4a46679abf0c",
      "name": "Année_relative",
      "description": "N, N-1, etc.",
      "output_column": "Année_relative",
      "param_schema": [],
      "required_columns": [
        "Année",
        "Semaine"
      ],
      "code": "_ord = df['Année'].astype(int)*52 + (df['Semaine'].astype(int)-1)\r\n_delta = (_ord.max() - _ord)\r\n_block52 = (_delta // 52).astype(int)\r\nvalue = _block52.map(lambda b: \"N\" if b == 0 else f\"N-{b}\")\r\n",
      "order": 2
    },
    {
      "id": "4a9b200b-f8dc-4201-96d8-0d7c6f09cff8",
      "name": "Trimestre_relatif",
      "description": "T, T-1, etc.",
      "output_column": "Trimestre_relatif",
      "param_schema": [],
      "required_columns": [
        "Année",
        "Semaine"
      ],
      "code": "_ord = df['Année'].astype(int)*52 + (df['Semaine'].astype(int)-1)\r\n_delta = (_ord.max() - _ord)\r\n_block13 = (_delta // 13).astype(int)\r\nvalue = _block13.map(lambda b: \"T\" if b == 0 else f\"T-{b:02d}\")\r\n",
      "order": 3
    }
  ],
