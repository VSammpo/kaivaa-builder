  "defaults": {
    "source": {
      "type": "python_only",
      "python": "import pandas as pd\r\nfrom datetime import datetime, timedelta\r\n\r\n# Configuration\r\ndate_debut = '2020-01-01'\r\ndate_fin = '2030-12-31'\r\n\r\n# Génération de la plage de dates\r\ndates = pd.date_range(start=date_debut, end=date_fin, freq='D')\r\ndf = pd.DataFrame({'date': dates})\r\n\r\n# ===== COMPOSANTES TEMPORELLES DE BASE =====\r\ndf['annee'] = df['date'].dt.year\r\ndf['mois'] = df['date'].dt.month\r\ndf['jour'] = df['date'].dt.day\r\ndf['jour_semaine'] = df['date'].dt.dayofweek + 1  # 1=Lundi, 7=Dimanche\r\n\r\n# Libellés en français\r\njours_fr = {1: 'Lundi', 2: 'Mardi', 3: 'Mercredi', 4: 'Jeudi', 5: 'Vendredi', 6: 'Samedi', 7: 'Dimanche'}\r\nmois_fr = {1: 'Janvier', 2: 'Février', 3: 'Mars', 4: 'Avril', 5: 'Mai', 6: 'Juin',\r\n           7: 'Juillet', 8: 'Août', 9: 'Septembre', 10: 'Octobre', 11: 'Novembre', 12: 'Décembre'}\r\n\r\ndf['nom_jour'] = df['jour_semaine'].map(jours_fr)\r\ndf['nom_mois'] = df['mois'].map(mois_fr)\r\n\r\n# ===== PÉRIODES =====\r\ndf['semaine_annee'] = df['date'].dt.isocalendar().week\r\ndf['trimestre'] = df['date'].dt.quarter\r\ndf['annee_mois'] = df['date'].dt.strftime('%Y-%m')\r\n\r\n# ===== JOURS FÉRIÉS FRANCE =====\r\n# Créer dictionnaire de tous les jours fériés\r\nall_feries = {}\r\nferies_noms = {}\r\n\r\nfor annee in range(2020, 2031):\r\n    # Jours fixes\r\n    feries_fixes = [\r\n        (datetime(annee, 1, 1).date(), \"Jour de l'an\"),\r\n        (datetime(annee, 5, 1).date(), \"Fête du travail\"),\r\n        (datetime(annee, 5, 8).date(), \"Victoire 1945\"),\r\n        (datetime(annee, 7, 14).date(), \"Fête nationale\"),\r\n        (datetime(annee, 8, 15).date(), \"Assomption\"),\r\n        (datetime(annee, 11, 1).date(), \"Toussaint\"),\r\n        (datetime(annee, 11, 11).date(), \"Armistice 1918\"),\r\n        (datetime(annee, 12, 25).date(), \"Noël\")\r\n    ]\r\n    \r\n    for date_ferie, nom in feries_fixes:\r\n        all_feries[date_ferie] = True\r\n        feries_noms[date_ferie] = nom\r\n    \r\n    # Calcul de Pâques (algorithme de Meeus)\r\n    a = annee % 19\r\n    b = annee // 100\r\n    c = annee % 100\r\n    d = b // 4\r\n    e = b % 4\r\n    f = (b + 8) // 25\r\n    g = (b - f + 1) // 3\r\n    h = (19 * a + b - d - g + 15) % 30\r\n    i = c // 4\r\n    k = c % 4\r\n    l = (32 + 2 * e + 2 * i - h - k) % 7\r\n    m = (a + 11 * h + 22 * l) // 451\r\n    mois_paques = (h + l - 7 * m + 114) // 31\r\n    jour_paques = ((h + l - 7 * m + 114) % 31) + 1\r\n    \r\n    paques = datetime(annee, mois_paques, jour_paques)\r\n    \r\n    # Jours fériés mobiles\r\n    lundi_paques = (paques + timedelta(days=1)).date()\r\n    ascension = (paques + timedelta(days=39)).date()\r\n    lundi_pentecote = (paques + timedelta(days=50)).date()\r\n    \r\n    all_feries[lundi_paques] = True\r\n    all_feries[ascension] = True\r\n    all_feries[lundi_pentecote] = True\r\n    \r\n    feries_noms[lundi_paques] = \"Lundi de Pâques\"\r\n    feries_noms[ascension] = \"Ascension\"\r\n    feries_noms[lundi_pentecote] = \"Lundi de Pentecôte\"\r\n\r\ndf['est_ferie'] = df['date'].dt.date.map(all_feries).fillna(False).astype(int)\r\ndf['nom_ferie'] = df['date'].dt.date.map(feries_noms)\r\n\r\n# ===== INDICATEURS CLÉS =====\r\ndf['est_weekend'] = (df['jour_semaine'] >= 6).astype(int)\r\ndf['est_ouvre'] = ((df['est_weekend'] == 0) & (df['est_ferie'] == 0)).astype(int)\r\ndf['est_debut_mois'] = (df['jour'] == 1).astype(int)\r\ndf['est_fin_mois'] = df['date'].dt.is_month_end.astype(int)\r\n\r\n# Nombre de jours ouvrés dans le mois\r\njours_ouvres_mois = df[df['est_ouvre'] == 1].groupby('annee_mois').size()\r\ndf['nb_jours_ouvres_mois'] = df['annee_mois'].map(jours_ouvres_mois).fillna(0).astype(int)\r\n\r\n# ===== DATES UTILES =====\r\ndf['premier_jour_mois'] = df['date'].dt.to_period('M').dt.to_timestamp()\r\ndf['dernier_jour_mois'] = (df['date'].dt.to_period('M').dt.to_timestamp() + pd.offsets.MonthEnd(0))\r\n\r\n# Format français pour affichage\r\ndf['date_fr'] = df['date'].dt.strftime('%d/%m/%Y')\r\n\r\n# Trier et optimiser\r\ndf = df.sort_values('date').reset_index(drop=True)\r\n\r\nprint(f\"✅ Calendrier généré : {len(df):,} jours ({df['date'].min().date()} → {df['date'].max().date()})\")\r\nprint(f\"📊 Colonnes : {len(df.columns)}\")\r\nprint(f\"🏖️  Jours fériés : {df['est_ferie'].sum()}\")\r\nprint(f\"💼 Jours ouvrés : {df['est_ouvre'].sum():,}\")\r\n\r\n# IMPORTANT : Convertir la colonne date en string pour la sérialisation JSON\r\ndf['date'] = df['date'].dt.strftime('%Y-%m-%d')\r\ndf['premier_jour_mois'] = df['premier_jour_mois'].dt.strftime('%Y-%m-%d')\r\ndf['dernier_jour_mois'] = df['dernier_jour_mois'].dt.strftime('%Y-%m-%d')"
    },
